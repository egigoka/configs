{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(basename:*)",
      "Bash(date:*)",
      "Bash(dirname:*)",
      "Bash(false:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(id:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(ripgrep:*)",
      "Bash(true:*)",
      "Bash(uname:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(log show:*)",
      "Bash(ls:*)",
      "Bash(graphify:*)",
      "Bash(rocketsim:*)",
      "Bash(kilo:*)",
      "Bash(opencode:*)",
      "Bash(gh search:*)",
      "Bash(gh pr view:*)",
      "Bash(gh api:*)",
      "Bash(npm root:*)",
      "Bash(npm view:*)",
      "Bash(python3:*)",
      "Bash(git --no-pager:*)",
      "Bash(git log:*)",
      "Bash(bash:*)",
      "Bash(jq:*)",
      "Bash(git add:*)",
      "Bash(git diff:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "TodoWrite",
      "Skill",
      "Task",
      "mcp__cua-driver__start_session",
      "mcp__cua-driver__launch_app",
      "mcp__cua-driver__list_windows",
      "mcp__cua-driver__page",
      "mcp__cua-driver__end_session"
    ],
    "defaultMode": "default",
    "deny": [
      "Read(**/*.env)",
      "Read(**/*.env.*)",
      "Read(**/*secrets.py)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(**/*.key)",
      "Read(**/*.pem)"
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Mewing",
      "Gooning",
      "Skibidi",
      "Rizzing",
      "Gyatting",
      "Fanum taxing",
      "Sigma grinding",
      "Ohio vibing",
      "Edging",
      "Mogging",
      "Looksmaxxing",
      "Aura farming",
      "Glazing",
      "Yapping",
      "Ick checking",
      "NPC walking",
      "Delulu manifesting",
      "Slay queening",
      "Bussin",
      "No capping"
    ]
  },
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true
}
