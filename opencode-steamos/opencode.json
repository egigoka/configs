{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "cua-driver": {
        "type": "local",
        "command": [
          "cua-driver",
          "mcp"
        ],
        "disabled": false
      },
      "mobile-mcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@mobilenext/mobile-mcp@latest"
        ],
        "environment": {
          "MOBILEMCP_DISABLE_TELEMETRY": "1"
        },
        "disabled": false
      },
      "android-studio": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/stream",
        "disabled": false
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "oauth": {}
      }
    },
    "timeout": {
      "catalog": 120000,
      "execution": 120000
    }
  },
  "experimental": {
    "subagent_depth": 1,
    "todo": true
  },
  "plugins": [
    "opencode-claude-memory@2.2.1",
    "./v2-plugins/opencode-throughput-v2",
    "./v2-plugins/opencode-log-sanitizer-v2",
    "@tarquinen/opencode-dcp@3.2.0",
    "./v2-plugins/opencode-short-term-memory-v2",
    "./v2-plugins/opencode-codex-auth",
    "./plugins/caveman",
    "@dietrichgebert/ponytail@latest"
  ],
  "providers": {
    "openai": {
      "settings": {
        "transport": "http"
      },
      "body": {
        "reasoning": {
          "effort": "medium",
          "summary": "auto"
        },
        "text": {
          "verbosity": "medium"
        },
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*secrets.py",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*secret*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*token*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.key",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.pem",
      "effect": "deny"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "basename",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "date",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "dirname",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "false",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "file",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "graphify *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ripgrep",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "id",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python3 -m py_compile",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "realpath",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rocketsim *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "true",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uname",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "whoami",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which",
      "effect": "allow"
    }
  ]
}
